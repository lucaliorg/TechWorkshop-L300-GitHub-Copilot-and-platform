@{
    ViewData["Title"] = "Chat";
}

<h2>AI Chat</h2>
<p class="text-muted">Ask anything — powered by Phi-4</p>

<div class="row">
    <div class="col-md-8">
        <div class="mb-3">
            <textarea id="chatHistory" class="form-control" rows="14" readonly
                      placeholder="Conversation will appear here..."></textarea>
        </div>
        <div class="input-group">
            <input type="text" id="userMessage" class="form-control"
                   placeholder="Type your message..." autocomplete="off" />
            <button id="sendBtn" class="btn btn-primary" type="button">
                <i class="bi bi-send"></i> Send
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const chatHistory = document.getElementById('chatHistory');
            const userMessage = document.getElementById('userMessage');
            const sendBtn = document.getElementById('sendBtn');

            function appendToChat(role, text) {
                const prefix = role === 'user' ? 'You' : 'Assistant';
                chatHistory.value += prefix + ': ' + text + '\n\n';
                chatHistory.scrollTop = chatHistory.scrollHeight;
            }

            async function sendMessage() {
                const message = userMessage.value.trim();
                if (!message) return;

                appendToChat('user', message);
                userMessage.value = '';
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';

                try {
                    const response = await fetch('@Url.Action("Send", "Chat")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: message })
                    });

                    if (!response.ok) {
                        const err = await response.json();
                        appendToChat('assistant', 'Error: ' + (err.error || 'Request failed.'));
                        return;
                    }

                    const data = await response.json();
                    appendToChat('assistant', data.response);
                } catch (e) {
                    appendToChat('assistant', 'Error: Could not reach the server.');
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = '<i class="bi bi-send"></i> Send';
                }
            }

            sendBtn.addEventListener('click', sendMessage);
            userMessage.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });
        })();
    </script>
}
